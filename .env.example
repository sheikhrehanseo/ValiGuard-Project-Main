# Database connection; SQLite is used when unset
DATABASE_URL=sqlite:///./valiguard.db
# Required for production JWT sessions
VALIGUARD_JWT_SECRET=change-me
# Start the background QIE ingestion worker (1/0)
VALIGUARD_INGESTION_WORKER=1
# Enable mempool polling (1/0)
MEMPOOL_ENABLED=1
# Mainnet Tendermint gateway; use http://localhost:26657 for your own node
QIE_RPC_URL=https://rpc.cosmos.directory/qie
QIE_RPC_PROTOCOL=tendermint
QIE_CHAIN_ID=qie_1990-1
# Standard EVM RPC and explorer must refer to the same mainnet
QIE_EVM_RPC_URL=https://rpc1mainnet.qie.digital
QIE_EVM_RPC_ENABLED=1
QIE_EXPLORER_API_URL=https://mainnet.qie.digital/api/v2
QIE_COSMOS_REST_URL=https://rest.cosmos.directory/qie
QIE_VALIDATOR_DIRECTORY_URL=https://validators.cosmos.directory/chains/qie
# QIE release tag used by node setup scripts (github.com/qieadmin/qiev3-mainnet)
QIE_RELEASE_TAG=QIE-Mainnet-V6
# Allowed frontend origin in production
FRONTEND_ORIGIN=http://localhost:3001
# Frontend demo mode switches the dashboard to the live demo feed
NEXT_PUBLIC_DEMO_MODE=false
# Backend URL consumed by the frontend
NEXT_PUBLIC_API_URL=http://localhost:5000
