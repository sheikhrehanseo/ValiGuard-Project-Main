# Database connection; SQLite is used when unset
DATABASE_URL=sqlite:///./valiguard.db
# Required for production JWT sessions
VALIGUARD_JWT_SECRET=change-me
# Start the background QIE ingestion worker (1/0)
VALIGUARD_INGESTION_WORKER=1
# Enable mempool polling (1/0)
MEMPOOL_ENABLED=1
# Tendermint RPC endpoint
QIE_RPC_URL=http://localhost:26657
# QIE release tag used by node setup scripts (github.com/qieadmin/qiev3-mainnet)
QIE_RELEASE_TAG=QIE-Mainnet-V6
# Allowed frontend origin in production
FRONTEND_ORIGIN=http://localhost:3001
# Frontend demo mode switches the dashboard to the live demo feed
NEXT_PUBLIC_DEMO_MODE=false
# Backend URL consumed by the frontend
NEXT_PUBLIC_API_URL=http://localhost:5000
